generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Plan {
  FREE
  PRO
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum SubscriptionStatus {
  INCOMPLETE
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(USER)
  plan          Plan      @default(FREE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  chats            Chat[]
  usage            UsageRecord[]
  generations      ImageGeneration[]
  files            GeneratedFile[]
  subscription     Subscription?
}

/**
 * Planes de suscripción ofrecidos a los usuarios. Se administran
 * desde el panel de admin (/admin/plans). Cada plan puede tener su
 * propio link de checkout de Mercado Pago (opción "sin integración")
 * o usar el flujo por API.
 */
model PricingPlan {
  id              String   @id @default(cuid())
  name            String
  description     String?
  priceArs        Int
  frequency       Int      @default(1)
  mpPlanInitPoint String?
  mpPlanId        String?
  active          Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([active, sortOrder])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Chat {
  id        String    @id @default(cuid())
  userId    String
  title     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   Message[]
  generations ImageGeneration[]
  files      GeneratedFile[]
}

model Message {
  id        String      @id @default(cuid())
  chatId    String
  role      MessageRole
  content   String
  createdAt DateTime    @default(now())

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
}

model ImageGeneration {
  id        String   @id @default(cuid())
  userId    String
  chatId    String?
  provider  String
  model     String
  prompt    String
  imageUrl  String
  status    String   @default("completed")
  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat Chat? @relation(fields: [chatId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model GeneratedFile {
  id          String   @id @default(cuid())
  userId      String
  chatId      String?
  format      String
  filename    String
  contentType String
  data        Bytes
  createdAt   DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat Chat? @relation(fields: [chatId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model Subscription {
  id                 String               @id @default(cuid())
  userId             String               @unique
  mpPreferenceId     String?              @unique
  mpPaymentId        String?              @unique
  status             SubscriptionStatus   @default(INCOMPLETE)
  plan               Plan                 @default(PRO)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UsageRecord {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  count     Int      @default(1)
  period    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, period])
  @@index([userId, period])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  eventId     String    @unique
  type        String
  processed   Boolean   @default(false)
  processedAt DateTime?
  createdAt   DateTime  @default(now())
}