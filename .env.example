# ============================================================
#  Copia este archivo a `.env` y completa los valores.
#  NUNCA subas `.env` al repositorio.
# ============================================================

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000

# --- Base de datos (Supabase Postgres recomendado) ---
# Project Settings -> Database -> Connection string (PostgreSQL, idealmente con pooler para producción)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- NextAuth ---
# Generar: npx auth secret  ->  o  openssl rand -base64 32
AUTH_SECRET=""
# En producción debe ser la URL pública HTTPS del sitio (afecta cómo se guardan
# las cookies de sesión y adónde redirige Mercado Pago al volver).
AUTH_URL="http://localhost:3000"
# AUTH_TRUST_HOST=true  # necesario si el sitio está detrás de un proxy/load balancer
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- LLM del chat (cualquier endpoint compatible con OpenAI) ---
LLM_API_KEY=""
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="gpt-4o-mini"

# --- Imágenes ---
# fal.ai (Flux) - activo para pruebas: https://fal.ai/dashboard/keys
FAL_KEY=""
# Google Gemini API (Nano Banana) - para activar en el futuro: https://aistudio.google.com/apikey
GOOGLE_API_KEY=""

# --- Mercado Pago (suscripción mensual del plan Pro) ---
# https://www.mercadopago.com.ar/developers  ->  Credenciales de producción (ACCESS_TOKEN) o de prueba (TEST-...)
# El precio y el link de checkout se administran por plan desde el panel de admin (/admin/plans).
MP_ACCESS_TOKEN="APP_USR-... o TEST-..."
# URL pública para recibir el webhook (para pruebas locales usá ngrok/cloudflared). Por defecto usa APP_URL.
MP_WEBHOOK_URL="https://tu-dominio/api/mercadopago/webhook"

# --- Rate limiting (Upstash Redis) ---
# https://console.upstash.com/  -> crea una base Redis y copia REST URL y token
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN=""

# --- Storage de imágenes (CDN) ---
# Vercel Blob: https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=""
